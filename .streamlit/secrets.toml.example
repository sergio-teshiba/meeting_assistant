# Copia este archivo como .streamlit/secrets.toml (local) o pega su contenido en
# Streamlit Cloud → App → Settings → Secrets. NUNCA subas secrets.toml a git.

# --- Base de datos (si se omite, la app usa SQLite local en .local/) ---
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_KEY = "sb_secret_..."        # la llave SECRETA, no la publishable

# --- Cifrado de las API keys guardadas (muy recomendado) ---
# Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guárdala bien: si la pierdes, los usuarios tendrán que volver a pegar su API key.
ENCRYPTION_KEY = ""

# --- Monetización (opcional) ---
# Los enlaces de pago, el límite gratuito, el registro y el interruptor de Stripe
# se configuran en la app → pestaña «Administración». Aquí solo van las llaves:
APP_GEMINI_API_KEY = ""               # llave de la casa para usuarios Pro (proyecto de pago)
STRIPE_SECRET_KEY = ""                # rk_… (restringida, solo lectura de Customers y
                                      # Subscriptions) o sk_test_… para probar
